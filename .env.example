# Exact DNS hostnames allowed for PostgreSQL and REST connections, comma-separated.
# Empty by default: network sources stay disabled until the operator explicitly configures an allowlist.
RECONCILE_ALLOWED_HOSTS=

# PostgreSQL port allowlist. Defaults to 5432 when unset; add a port only when required.
RECONCILE_ALLOWED_POSTGRES_PORTS=5432

# Browser-based MCP clients are denied by default unless their exact origins are listed.
# Example: https://client.example,https://another-client.example (no wildcard paths).
MCP_ALLOWED_ORIGINS=

# Carbon estimate model. The power draw is an explicit illustrative assumption, not metered.
# The default grid factor is IEA Electricity 2025's 2024 global generation intensity.
RECONCILE_CARBON_ESTIMATED_POWER_W=50
RECONCILE_CARBON_GRID_INTENSITY_G_CO2_KWH=445
